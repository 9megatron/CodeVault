<Page x:Class="SnippetBox.EditorWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SnippetBox"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditorWindow">


    <Grid Background="#0a0a0a">
        <Border Background="#141414" 
                BorderBrush="#a8394a" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="20" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="600"
                MinWidth="400">

            <Border.Effect>
                <DropShadowEffect Color="#a8394a" BlurRadius="15" ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                    <!-- Это место теперь ограничено -->
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="РЕДАКТИРОВАНИЕ СНИППЕТА" 
                           Foreground="#a8394a" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Left" 
                           Margin="5,0"/>

                <!-- Поле заголовка -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Название" Foreground="Gray" Margin="5,0,0,5" FontSize="12"/>
                    <TextBox x:Name="TitleBox" Grid.Row="1"
                             Background="#1a1a1a" 
                             Foreground="#a8394a"
                             SelectionBrush="#a8394a"
                             CaretBrush="#a8394a"
                             BorderBrush="#333"
                             BorderThickness="1"
                             Padding="12"
                             FontSize="16"
                             FontFamily="Segoe UI"/>
                </Grid>

                <!-- Поле кода (ИСПРАВЛЕНО: Grid вместо StackPanel) -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <!-- TextBox займет всё доступное место и включит скролл -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Содержимое" Foreground="Gray" Margin="5,0,0,5" FontSize="12"/>
                    <TextBox x:Name="ContentBox" Grid.Row="1"
                             Background="#1a1a1a" 
                             Foreground="White"
                             SelectionBrush="#a8394a"
                             CaretBrush="White"
                             BorderBrush="#333"
                             BorderThickness="1"
                             Padding="12"
                             FontSize="14"
                             FontFamily="Consolas"
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Кнопки (ИСПРАВЛЕНО: Grid вместо StackPanel) -->
                <Grid Grid.Row="6" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        
                        <ColumnDefinition Width="*"/>
                        
                        <ColumnDefinition Width="Auto"/>
                        
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0" Content="Удалить" Click="DeleteButton_Click" FontSize="18"
                            Style="{StaticResource NeonButtonStyle}" Margin="0,0,373,0" Grid.ColumnSpan="2"/>

                    <Button Grid.Column="1" Content="Сохранить" FontSize="18" Click="SaveButton_Click" 
        Style="{StaticResource NeonButtonStyle}" Margin="196,0,124,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <Button Content="Закрыть" Click="CloseButton_Click"  FontSize="18" 
                                Style="{StaticResource NeonButtonStyle}" Width="90" Height="38"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
